class Solution(object):
    def fizzBuzz(self, n):
        """
        :type n: int
        :rtype: List[str]
        """
        res = [None] * n
        for x in range(1,n+1):
            if (x % 3) == 0 and (x % 5) == 0: 
                res[x-1] = "FizzBuzz"
            elif x % 3 == 0: 
                res[x-1] = "Fizz"
            elif x % 5 == 0: 
                res[x-1] = "Buzz"
            else: 
                res[x-1] = str(x)
        return res
            
