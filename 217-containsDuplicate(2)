class Solution(object):
    def containsDuplicate(self, nums):
        """
        :type nums: List[int]
        :rtype: bool
        """
        # march 10 2025
        lenArr = len(nums)
        lenSetArr = len(set(nums))
        if lenArr == lenSetArr: # if arr & set are eq we know there are NO DUPLICATES
            return False
        else:
            return True

