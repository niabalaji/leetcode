class Solution(object):
    def search(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        mid = 0 
        left = 0 
        right = len(nums)-1

        for x in range(len(nums)):
            mid = (left + right) // 2 
            if nums[mid] > target:
                right = mid
                right -= 1
            elif nums[mid] < target: 
                left = mid 
                left += 1
            elif nums[mid] == target: 
                return mid
        return -1

        
