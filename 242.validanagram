class Solution(object):
    def isAnagram(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        if len(s) != len(t):
            return False
        hashS = {}
        hashT = {}

        for x in range(len(s)):
            hashS[s[x]] = hashS.get(s[x],0) + 1
            hashT[t[x]] = hashT.get(t[x],0) + 1
            
        for key in hashS:
            if hashS[key] != hashT.get(key,0):
                return False
        return True














        
