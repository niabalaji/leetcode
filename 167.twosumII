class Solution(object):
    def twoSum(self, numbers, target):
        """
        :type numbers: List[int]
        :type target: int
        :rtype: List[int]
        """
        # brute force solution -> check every pair possible [O(n^2)]
        # using two pointer sol - [O(n)]
        l, r = 0, len(numbers)-1
        while l < r: 
            currSum = numbers[l] + numbers[r]
            if currSum < target: 
                l += 1
            elif currSum > target: 
                r -= 1 
            else:
                return [l+1,r+1]
        return []

            
        
